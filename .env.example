# ============================================================================
# RiskLens v2.1.0 Enterprise Production Environment Variables
# Copy this file to '.env' for local staging/development.
# In production (Railway / Render), set these variables in the platform dashboard.
# NEVER commit the active '.env' file containing real secrets to source control.
# ============================================================================

# 1. Telegram Bot Integration
# Generated via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Bot mode: 'polling' (for Hugging Face Spaces / local) or 'webhook' (for Render / Railway)
TELEGRAM_MODE=polling
# Secret token for webhook authenticity validation (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# 2. Fact-Checking & Web Search APIs
# Google Fact Check Tools API Key
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here
# Serper.dev Google Web Search API Key (for Agentic deep-dive verification)
SERPER_API_KEY=your_serper_api_key_here

# 3. Security & Telemetry Access Control
# Secret API key required to access /analytics, /analytics/dashboard, /operations/metrics
RISKLENS_API_KEY=your_risklens_admin_api_key_here
# Cryptographic salt used for HMAC-SHA256 pseudonymization of user IDs (PII protection)
USER_ID_SALT=your_random_cryptographic_user_salt_here

# 4. Observability, Error Tracking & Alerting
# Sentry DSN for exception tracking and performance tracing (Free tier: 5k errors/mo)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Telegram Admin Chat ID for critical automated push alerts (0 cost, uses TELEGRAM_BOT_TOKEN)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_or_group_id_here
# Generic Slack / Discord Webhook URL for team alerting (Optional)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Model quality drift alert threshold (Triggers alert if live accuracy drops below this)
ACCURACY_ALERT_THRESHOLD=0.75

# 5. Storage & Persistence (SQLite Persistent Volume Mount)
# Path to persistent volume directory (/app/databases on Render/Railway, ./databases locally)
DATABASE_DIR=/app/databases

# 6. Optional Integrations & Network Configuration
# Twilio WhatsApp Sandbox (Optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Environment & Server Config
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
BACKEND_API_URL=https://your-risklens-api.onrender.com
